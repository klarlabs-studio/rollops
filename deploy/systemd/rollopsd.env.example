# Rollops daemon environment.
# Install to /etc/rollops/rollopsd.env, set owner root:rollops and mode 0640.

# Runtime state.
ROLLOPS_DB=/var/lib/rollops/rollops.db
ROLLOPS_WORKDIR=/var/lib/rollops/repos

# Network surfaces. Bind HTTP/gRPC to loopback and put TLS/mTLS at the reverse
# proxy or host boundary unless you explicitly expose them.
ROLLOPS_ADDR=127.0.0.1:8080
ROLLOPS_GRPC_ADDR=127.0.0.1:8090

# Required for API/CLI daemon mode. Generate with:
#   openssl rand -hex 32
ROLLOPS_ADMIN_TOKEN=

# Required to enable /ui. Leave password empty to keep the UI disabled.
ROLLOPS_UI_USER=admin
ROLLOPS_UI_PASSWORD=

# Optional MCP agent surface. Leave empty to disable.
ROLLOPS_MCP_ADDR=
ROLLOPS_MCP_AGENT=local

# Git watch loop. JSON list of repos to reconcile.
# Example:
# ROLLOPS_WATCH=[{"name":"demo","url":"https://github.com/acme/app.git","branch":"main","path":"rollops.yaml"}]
ROLLOPS_WATCH=[]
ROLLOPS_RECONCILE_INTERVAL=30s

# Secrets and artifact verification.
ROLLOPS_COSIGN_KEY=

# Optional notifications (see docs/notifications.md).
# Briefkasten outbox (preferred for mail — durable, retried):
ROLLOPS_BRIEFKASTEN_URL=
ROLLOPS_BRIEFKASTEN_TO=
ROLLOPS_BRIEFKASTEN_TOKEN=
# Direct SMTP:
ROLLOPS_SMTP_ADDR=
ROLLOPS_SMTP_FROM=
ROLLOPS_SMTP_TO=
ROLLOPS_SMTP_USER=
ROLLOPS_SMTP_PASS=
# Generic webhook:
ROLLOPS_WEBHOOK_URL=
ROLLOPS_WEBHOOK_SECRET=
