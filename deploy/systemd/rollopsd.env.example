# Rollops daemon environment.
# Install to /etc/rollops/rollopsd.env, set owner root:rollops and mode 0640.

# Runtime state.
ROLLOPS_DB=/var/lib/rollops/rollops.db
ROLLOPS_WORKDIR=/var/lib/rollops/repos

# Network surfaces. A loopback bind (below) needs no TLS — front it with a
# same-host reverse proxy that terminates TLS. To expose a surface directly on
# the network, bind a routable address AND set the TLS vars below; rollopsd
# refuses a non-loopback bind without them (no override).
ROLLOPS_ADDR=127.0.0.1:8080
ROLLOPS_GRPC_ADDR=127.0.0.1:8090

# Native TLS 1.3 (see docs/tls.md). Required for any non-loopback bind; leave
# unset for loopback binds. Set CERT and KEY together (server keypair, PEM).
# Add CLIENT_CA to require mTLS on the machine control plane (REST API, gRPC,
# MCP); the browser UI stays server-TLS + OIDC/session. cert-manager or any tool
# that rewrites the cert file is picked up live (hot-reload on mtime change).
#ROLLOPS_TLS_CERT=/etc/rollops/tls/tls.crt
#ROLLOPS_TLS_KEY=/etc/rollops/tls/tls.key
#ROLLOPS_TLS_CLIENT_CA=/etc/rollops/tls/ca.crt

# Required for API/CLI daemon mode. Generate with:
#   openssl rand -hex 32
ROLLOPS_ADMIN_TOKEN=

# Required to enable /ui. Leave password empty to keep the UI disabled.
ROLLOPS_UI_USER=admin
ROLLOPS_UI_PASSWORD=

# Optional MCP agent surface. Leave empty to disable.
ROLLOPS_MCP_ADDR=
ROLLOPS_MCP_AGENT=local

# Git watch loop. JSON list of repos to reconcile.
# Example:
# ROLLOPS_WATCH=[{"name":"demo","url":"https://github.com/acme/app.git","branch":"main","path":"rollops.yaml"}]
ROLLOPS_WATCH=[]
ROLLOPS_RECONCILE_INTERVAL=30s

# Artifact verification, before deploy. Enforcing, and failing closed — but
# only once something below is set. With all of it empty rollopsd deploys
# whatever Git points at, unsigned included.
#
# Each line adds a link, and each is a different authority:
#
#   1. the SIGNATURE says somebody with the key vouched for these bytes
#   2. the BUILDER says which platform produced them, so a stolen key alone
#      no longer passes an artifact off as one from your pipeline
#   3. the SOURCE GATE says the commit was allowed to be built at all, and is
#      checked against the gate's OWN key — so the builder cannot vouch for it
#
# Setting only the key gets you link 1. Most of the value is in 2 and 3.

# 1. Signature: a cosign public key, or a keyless identity + issuer.
ROLLOPS_COSIGN_KEY=
ROLLOPS_COSIGN_IDENTITY=
ROLLOPS_COSIGN_ISSUER=

# 2. Builder: which platforms may vouch for a deployable artifact. A trailing
#    @ accepts any version. Comma-separated. Not kiln-specific — a GitHub
#    Actions workflow identity is as valid a builder here as kiln's own.
# ROLLOPS_PROVENANCE_BUILDERS=https://github.com/klarlabs-studio/kiln@
#
#    Reject an artifact whose source checks were INHERITED from a note rather
#    than run during that build. Off by default: inheriting is legitimate and
#    requiring a re-prove rejects most of a healthy pipeline's output.
# ROLLOPS_PROVENANCE_REQUIRE_REPROVED=false

# 3. Source gate: whose verdict about the commit counts, and the key that
#    verdict is verified against. Both are needed — a gate list with no key
#    means trusting whoever carried the summary.
# ROLLOPS_SOURCE_GATES=https://warden.klarlabs.de
# ROLLOPS_SOURCE_KEYS=<base64 ed25519, as `warden key show` prints it>
# ROLLOPS_SOURCE_REQUIRE_LEVELS=WARDEN_SOURCE_SIGNED

# Optional notifications (see docs/notifications.md).
# Briefkasten outbox (preferred for mail — durable, retried):
ROLLOPS_BRIEFKASTEN_URL=
ROLLOPS_BRIEFKASTEN_TO=
ROLLOPS_BRIEFKASTEN_TOKEN=
# Direct SMTP:
ROLLOPS_SMTP_ADDR=
ROLLOPS_SMTP_FROM=
ROLLOPS_SMTP_TO=
ROLLOPS_SMTP_USER=
ROLLOPS_SMTP_PASS=
# Generic webhook:
ROLLOPS_WEBHOOK_URL=
ROLLOPS_WEBHOOK_SECRET=
