# Agent-facing rollopsd knobs (snippets — merge into your real env).
ROLLOPS_MCP_ADDR=127.0.0.1:8091
ROLLOPS_MCP_TOKENS_FILE=/etc/rollops/mcp-tokens.json
ROLLOPS_POLICY_FILE=/etc/rollops/rbac-agent-deploy.yaml

# Agent-grade provenance: set to a cosign public key path to enforce verify
# before deploy. Unset = agents can deploy without artifact provenance checks.
# ROLLOPS_COSIGN_KEY=/etc/rollops/cosign.pub
