{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.klarlabs.de/rollops/v1/rollout-config.json",
  "title": "Rollops RolloutConfig",
  "description": "Declarative rollout configuration for a single service/target. Surface format is YAML; this schema is the published contract. Schema version is rollops.klarlabs.de/v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "rollops.klarlabs.de/v1",
      "description": "Schema version. A new major bumps this so configs migrate cleanly."
    },
    "kind": {
      "type": "string",
      "const": "RolloutConfig"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "strategy"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "environments": {
          "type": "array",
          "items": { "$ref": "#/$defs/environment" }
        },
        "strategy": { "$ref": "#/$defs/strategy" },
        "risk": { "$ref": "#/$defs/risk" },
        "rollback": { "$ref": "#/$defs/rollback" },
        "analysis": { "$ref": "#/$defs/analysis" },
        "featureFlags": { "$ref": "#/$defs/featureFlags" },
        "trafficRouting": { "$ref": "#/$defs/trafficRouting" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Target refs that must complete before this one."
        },
        "schedule": {
          "type": "string",
          "format": "date-time",
          "description": "RFC3339 future time to queue this rollout."
        },
        "verification": {
          "type": "string",
          "enum": ["shallow", "full"],
          "description": "Drift verification depth. shallow (default): stamped-checksum marker. full: also diff live against desired so out-of-band field edits are caught."
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "criticality"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Target plugin: ssh | ftp | kubernetes | <community plugin>."
        },
        "ref": { "type": "string", "minLength": 1, "description": "Stable target identity." },
        "criticality": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Operator-set blast-radius weight feeding the risk gate."
        },
        "spec": {
          "type": "object",
          "description": "Target-specific desired state; validated by the target plugin.",
          "additionalProperties": true
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "promote": {
          "type": "boolean",
          "description": "Whether this env participates in the staged promotion chain."
        },
        "strategy": { "$ref": "#/$defs/strategy" }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["rolling", "canary", "blue-green"]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
              "pause": { "type": "string", "description": "Go duration, e.g. 5m." }
            }
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Auto-proceed below this normalized score."
        },
        "sensitive": {
          "type": "string",
          "description": "CEL boolean expression; when true, forces human approval."
        },
        "history": { "$ref": "#/$defs/riskHistory" }
      }
    },
    "riskHistory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional recent rollback history signal for the risk gate. Lookback is a number of recent target history records.",
      "properties": {
        "lookback": {
          "type": "integer",
          "minimum": 0,
          "description": "Recent target history records to inspect. Zero disables the history signal."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Additional normalized score weight assigned to rollback history."
        },
        "maxFailures": {
          "type": "integer",
          "minimum": 0,
          "description": "Rollback count treated as maximum historical risk."
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto": { "type": "boolean" },
        "healthCheck": { "$ref": "#/$defs/healthCheck" },
        "smokeTest": { "$ref": "#/$defs/smokeTest" },
        "database": { "$ref": "#/$defs/databaseRollback" },
        "trigger": {
          "type": "string",
          "description": "Optional CEL boolean expression that fires a rollback."
        }
      }
    },
    "databaseRollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "Optional command hook run after manifest auto-rollback for database migration rollback.",
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Executable and args, e.g. [\"goose\", \"down\"]."
        },
        "timeout": {
          "type": "string",
          "description": "Go duration for the rollback command."
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "description": "Observability-free probe. Exactly one of http/tcp/command.",
      "properties": {
        "http": { "type": "string" },
        "tcp": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" } },
        "timeout": { "type": "string", "description": "Go duration." }
      },
      "oneOf": [
        { "required": ["http"] },
        { "required": ["tcp"] },
        { "required": ["command"] }
      ]
    },
    "smokeTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "expectExit": { "type": "integer", "default": 0 }
      }
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "sha256", "flag"],
      "description": "Couple the rollout to a feature-flag provider plugin; the flag percentage tracks the traffic weight.",
      "properties": {
        "plugin": { "type": "string", "minLength": 1, "description": "Path to the flag plugin binary." },
        "sha256": { "type": "string", "minLength": 1, "description": "Required sha256 pin of the plugin binary." },
        "flag": { "type": "string", "minLength": 1, "description": "Flag key to drive." },
        "environment": { "type": "string", "description": "Provider environment." },
        "when": { "type": "string", "enum": ["step", "promote", "both"], "description": "When to drive the flag (default both)." }
      }
    },
    "trafficRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "sha256", "route", "stableService", "canaryService"],
      "description": "Couple the rollout to a traffic-router plugin; each canary step shifts that weight of live traffic to the canary backend.",
      "properties": {
        "plugin": { "type": "string", "minLength": 1, "description": "Path to the traffic-router plugin binary." },
        "sha256": { "type": "string", "minLength": 1, "description": "Required sha256 pin of the plugin binary." },
        "route": { "type": "string", "minLength": 1, "description": "Router object name (e.g. Gateway API HTTPRoute)." },
        "namespace": { "type": "string", "description": "Router object namespace." },
        "stableService": { "type": "string", "minLength": 1, "description": "Backend receiving (100-weight)% of traffic." },
        "canaryService": { "type": "string", "minLength": 1, "description": "Backend receiving weight% of traffic." }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "metrics", "condition"],
      "description": "Metric-based rollout analysis. Provider-agnostic.",
      "properties": {
        "provider": { "type": "string", "minLength": 1, "description": "prometheus (built-in) or a metricprovider plugin name." },
        "address": { "type": "string" },
        "plugin": { "type": "string", "description": "Path to a metricprovider plugin binary (alternative to a built-in provider)." },
        "sha256": { "type": "string", "description": "Required sha256 pin when plugin is set." },
        "condition": { "type": "string", "minLength": 1, "description": "CEL boolean over metric names; true == healthy." },
        "interval": { "type": "string", "description": "Go duration between measurements." },
        "count": { "type": "integer", "minimum": 1 },
        "failureLimit": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "query"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "query": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
